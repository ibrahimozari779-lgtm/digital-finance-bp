# Bu dosyayı ".env" olarak kopyalayın ve kendi anahtarınızı girin:
#   cp .env.example .env
#
# Ücretsiz Gemini API anahtarını buradan alabilirsiniz:
#   https://aistudio.google.com/apikey
#
GEMINI_API_KEY=buraya_kendi_anahtarinizi_yapistirin
# Opsiyonel — varsayılan gemini-2.0-flash. Değiştirmek isterseniz açın:
# GEMINI_MODEL=gemini-2.0-flash
